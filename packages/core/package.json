{
  "name": "@tracebug/core",
  "version": "0.1.0",
  "description": "Headless business logic for tracebug — types, stage parsing, response shaping",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@tracebug/tsconfig": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
