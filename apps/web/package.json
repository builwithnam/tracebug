{
  "name": "web",
  "version": "0.1.0",
  "description": "Debug tool for tracing AI chatbot pipeline stages",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tracebug": "./dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"tsx watch src/server/index.ts\" \"vite dev --host\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:vite": "vite dev --host",
    "build": "tsc && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/server/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/server/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "check": "npm run lint && npm run format:check",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "debug",
    "trace",
    "ai",
    "chatbot",
    "pipeline"
  ],
  "license": "MIT",
  "dependencies": {
    "@tracebug/core": "workspace:*",
    "@tracebug/ui": "workspace:*",
    "mysql2": "^3.11.0",
    "open": "^10.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tracebug/tsconfig": "workspace:*",
    "@types/node": "^22.19.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.3.0",
    "vitest": "^4.1.4"
  }
}
