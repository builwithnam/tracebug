{
  "name": "@tracebug/server",
  "version": "0.1.0",
  "description": "Express API server for tracebug",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "type-check": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@tracebug/core": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tracebug/tsconfig": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.17",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^17.24.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
