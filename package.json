{
  "name": "tracebug",
  "version": "0.1.0",
  "description": "Debug tool for tracing AI chatbot pipeline stages",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tracebug": "./dist/index.js"
  },
  "files": [
    "dist/",
    "src/public/"
  ],
  "scripts": {
    "build": "tsc && cp -r src/public dist/public",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test tests/**/*.test.ts"
  },
  "keywords": [
    "debug",
    "trace",
    "ai",
    "chatbot",
    "pipeline"
  ],
  "license": "MIT",
  "dependencies": {
    "mysql2": "^3.11.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
